# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

region              = "us-east-1"
foundation_model_id = "us.anthropic.claude-sonnet-4-6"

# CloudWatch log group for invocation telemetry (AgentCore Observability native;
# replaces the prior Langfuse stack). Defaults are usually fine.
# invocation_log_group           = "/gagent/invocations"
# invocation_log_retention_days  = 30

# Optional: extra IAM principals beyond the deploying caller identity.
# lf_admin_principal_arns = ["arn:aws:iam::123456789012:role/SomeOperatorRole"]
# trusted_assumer_arns    = ["arn:aws:iam::123456789012:role/GitHubActionsCI"]

# Optional: SageMaker Unified Studio project execution roles that should see the
# governed database inside Studio. Each gets Owner-equivalent LF grants on the
# database (SELECT on all tables + DESCRIBE on the db). Leave empty for clients
# that don't use SMUS.
# smus_reader_role_arns = [
#   "arn:aws:iam::123456789012:role/service-role/AmazonSageMakerAdminIAMExecutionRole",
# ]

# tags = {
#   CostCenter = "ms3dm-flagship"
# }

# ---- Phase 3.a — public web demo ----
#
# The auth module currently surfaces only the Cognito-managed (email/password)
# sign-in option in the Hosted UI. Federated IdPs (Google, GitHub, Slack) are
# deferred to Phase 3.5 — see terraform/modules/auth/main.tf for the full
# rationale. No OAuth credentials are required to deploy.

# Optional overrides:
# web_domain_name                  = "demo.ms3dm.tech"
# gateway_persona_resolution_mode  = "request-param"   # or "claim-bound" for client deployments
# gateway_default_service_region   = "tempe-mesa"      # used only by claim-bound mode
# gateway_rate_limit_per_5min      = 100

# ---- ADR-013 §5.2 cost guardrails ----
#
# notification_email is REQUIRED. AWS sends a one-time confirmation email after
# the first apply; the operator must click the confirm link before the warn /
# hard-stop alarms can notify. See terraform/modules/cost-guardrails/README.md
# for the full flow.

notification_email = "ops@example.com"

# Optional threshold overrides:
# cost_alarm_warn_threshold_usd      = 50
# cost_alarm_hard_stop_threshold_usd = 200
